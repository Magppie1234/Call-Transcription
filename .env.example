# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Zoho ---
# From api-console.zoho.com -> Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Filled in by scripts/get_refresh_token.py
ZOHO_REFRESH_TOKEN=

# Your data centre. One of: com, in, eu, com.au, jp
# Check the domain you use to log into Zoho CRM.
ZOHO_DC=in

# --- Zoho Session Cookie (Bypass Ozonotel) ---
# Copy the entire 'Cookie' request header from your browser when logged into Zoho CRM
# This allows downloading the audio via the phonebridge proxy URL.
ZOHO_COOKIE=

# --- Sarvam (not needed for discovery) ---
SARVAM_API_KEY=

# --- Vercel Blob (transcript storage for the deployed dashboard) ---
# From the Vercel dashboard -> project -> Storage tab -> your Blob store.
# Needed to run scripts/sync_transcripts_to_blob.py after new transcripts are
# generated. The dashboard itself gets this automatically when deployed on
# Vercel with the store attached.
BLOB_READ_WRITE_TOKEN=
