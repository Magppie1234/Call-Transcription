# Annotated env manifest. Real values: copy from the original machine —
# root `.env` (Python scripts) and `dashboard/.env.local` (Next.js app).
# Never paste these values into a chat; fill the files directly.

# ── Zoho CRM — Self Client, INDIA data centre (.in, org 8681355) ──────────
ZOHO_CLIENT_ID=            # api-console.zoho.in → the one existing Self Client
ZOHO_CLIENT_SECRET=        # same page, "Client Secret" tab
ZOHO_REFRESH_TOKEN=        # never expires; .env and dashboard/.env.local hold different (both valid) tokens
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Browser session cookie from a logged-in Zoho CRM tab. Used to download call
# audio because Ozonetel API creds were never obtained. EXPIRES periodically —
# refresh from DevTools → Network → request Cookie header when audio breaks.
ZOHO_COOKIE=

